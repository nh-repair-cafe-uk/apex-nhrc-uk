---
import { getEntry } from 'astro:content';

const settings = await getEntry('site-settings', 'main');
if (!settings) throw new Error('site-settings/main entry is missing');
const { stats } = settings.data;
---

<section id="about" class="about">
  <div class="container">
    <div class="section-title">
      <h2>About</h2>
      <p style="font-family: 'Allerta Stencil', sans-serif;">What is a <span>Repair Café?</span></p>
    </div>

    <div class="row">
      <div class="col-lg-8">
        <p>
          A Repair Café is a free, volunteer-run event where you bring in broken things —
          electricals, clothes, furniture, toys, whatever's given up — and fix them together with
          someone who knows how, instead of throwing them away. You leave with a working repair
          and a new skill, and less goes to landfill.
        </p>
        <p class="fst-italic">
          <i class="bx bx-recycle" aria-hidden="true" style="color:green"></i> Repair
          <i class="bx bx-recycle" aria-hidden="true" style="color:orange"></i> Reuse
          <i class="bx bxs-heart" aria-hidden="true" style="color:red"></i> Relove
        </p>
        <p>
          It's free to bring something in, but donations are always welcome — they cover our
          tools and running costs.
          <a
            href="https://www.youtube.com/watch?v=5zY_iv1_z4c"
            target="_blank"
            rel="noopener noreferrer"
          >Watch how it works</a>.
        </p>
      </div>

      <div class="col-lg-4">
        <div class="row">
          <div class="col-6">
            <div class="count-box">
              <i class="bi bi-emoji-smile"></i>
              <span>{stats.happyClients.toLocaleString()}</span>
              <p>Happy clients</p>
            </div>
          </div>
          <div class="col-6">
            <div class="count-box">
              <i class="bi bi-recycle"></i>
              <span>{stats.landfillKg.toLocaleString()}kg</span>
              <p>Landfill avoided</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
