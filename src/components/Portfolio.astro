---
import { getEntry } from 'astro:content';

const gallery = await getEntry('portfolio', 'gallery');
if (!gallery) throw new Error('portfolio/gallery entry is missing');
---

<section id="portfolio" class="portfolio">
  <div class="container">
    <div class="section-title">
      <h2>Pictures</h2>
      <p>Some of our recent activity</p>
    </div>

    <div class="row portfolio-container">
      {
        gallery.data.items.map((item) => (
          <div class="col-lg-3 col-md-6 portfolio-item">
            <img src={item.image} class="img-fluid" alt={item.title} loading="lazy" />
            <div class="portfolio-info">
              <h4>{item.title}</h4>
              <p>{item.caption}</p>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>
