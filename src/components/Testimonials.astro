---
import { getCollection } from 'astro:content';

const testimonials = (await getCollection('testimonials')).sort((a, b) => a.data.order - b.data.order);
---

<section id="testimonials" class="testimonials">
  <div class="container">
    <div class="row">
      {
        testimonials.map((testimonial) => (
          <div class="col-lg-4">
            <div class="testimonial-item">
              <h3>{testimonial.data.author}</h3>
              <p>
                <i class="bx bxs-quote-alt-left quote-icon-left" />
                {testimonial.data.quote}
                <i class="bx bxs-quote-alt-right quote-icon-right" />
              </p>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>
