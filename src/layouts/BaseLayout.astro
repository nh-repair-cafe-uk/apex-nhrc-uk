---
import '../styles/style.css';
import 'bootstrap/dist/css/bootstrap.min.css';
import 'bootstrap-icons/font/bootstrap-icons.css';
import 'boxicons/css/boxicons.min.css';
import 'remixicon/fonts/remixicon.css';
import 'aos/dist/aos.css';
import 'swiper/swiper-bundle.css';
import { getEntry } from 'astro:content';

const settings = await getEntry('site-settings', 'main');
if (!settings) throw new Error('site-settings/main entry is missing');
const { gtagId, statcounterProject, statcounterSecurity } = settings.data;

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'North Hampshire Repair Café - Sherfield, Hartley Wintney, Hook, Bramley, Old Basing',
  description = 'North Hampshire Repair Café: community repair events for electricals, computers, clothes, furniture, garden tools, toys, bikes, jewellery and clocks across Sherfield, Hartley Wintney, Hook, Bramley and Old Basing.',
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content="repair cafe, north hampshire, sherfield, hartley wintney, hook, bramley, old basing, repair, sustainability, recycling" />

    <link rel="icon" href="/assets/img/favicon.png" />
    <link rel="apple-touch-icon" href="/assets/img/apple-touch-icon.png" />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Public+Sans:ital,wght@0,300..800;1,300..800&family=Space+Grotesk:wght@500..700&family=Space+Mono:wght@400;700&family=Allerta+Stencil&display=swap"
      rel="stylesheet"
    />

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content="/assets/img/repaircafe-frontv7blue.jpg" />
  </head>

  <body
    data-gtag-id={gtagId}
    data-statcounter-project={statcounterProject}
    data-statcounter-security={statcounterSecurity}
  >
    <slot />

    <div id="preloader"></div>
    <a href="#hero" class="back-to-top d-flex align-items-center justify-content-center" aria-label="Back to top">
      <i class="bi bi-arrow-up-short"></i>
    </a>

    <script>
      import '../scripts/preloader';
      import '../scripts/nav';
      import '../scripts/back-to-top';
      import '../scripts/aos-init';
      import '../scripts/counters';
      import '../scripts/cookie-consent';
    </script>
  </body>
</html>
