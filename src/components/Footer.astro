---
import { getEntry } from 'astro:content';

const settings = await getEntry('site-settings', 'main');
if (!settings) throw new Error('site-settings/main entry is missing');
const { contactEmail, facebookUrl, instagramUrl, paypalHostedButtonId } = settings.data;
---

<footer id="footer">
  <div class="footer-top">
    <div class="container">
      <div class="row">
        <div class="col-lg-4 col-md-6">
          <div class="footer-info">
            <h3>North Hampshire Repair Café</h3>
            <p><strong>Email:</strong> {contactEmail}<br /></p>
            <div class="social-links mt-3">
              <a href={facebookUrl} class="facebook" title="Facebook" target="_blank" rel="noopener noreferrer">
                <i class="bx bxl-facebook"></i>
              </a>
              <a href={instagramUrl} class="instagram" title="Instagram" target="_blank" rel="noopener noreferrer">
                <i class="bx bxl-instagram"></i>
              </a>
            </div>
          </div>
        </div>

        <div class="col-lg-3 col-md-6 footer-links">
          <h4>Useful Links</h4>
          <ul>
            <li><i class="bx bx-chevron-right"></i> <a href="/">Home</a></li>
            <li><i class="bx bx-chevron-right"></i> <a href="#about">About</a></li>
            <li><i class="bx bx-chevron-right"></i> <a href="#features">Events</a></li>
            <li><i class="bx bx-chevron-right"></i> <a href="#house-rules">House Rules</a></li>
            <li><i class="bx bx-chevron-right"></i> <a href="/assets/privacy.pdf" target="_blank" rel="noopener noreferrer">Privacy policy</a></li>
          </ul>
        </div>

        <div class="col-lg-5 col-md-6 footer-newsletter">
          <p>We repair for free — donations help cover our costs.</p>
          <form action="https://www.paypal.com/donate" method="post" target="_top">
            <input type="hidden" name="hosted_button_id" value={paypalHostedButtonId} />
            <input
              type="image"
              src="https://www.paypalobjects.com/en_GB/i/btn/btn_donate_SM.gif"
              name="submit"
              title="PayPal - The safer, easier way to pay online!"
              alt="Donate with PayPal"
            />
          </form>
        </div>
      </div>
    </div>
  </div>

  <div class="container">
    <div class="copyright">
      &copy; Copyright <strong><span>North Hampshire Repair Café</span></strong>. All Rights Reserved
    </div>
  </div>
</footer>
