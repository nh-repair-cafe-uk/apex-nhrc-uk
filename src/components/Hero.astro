---
import { getEntry } from 'astro:content';

const settings = await getEntry('site-settings', 'main');
if (!settings) throw new Error('site-settings/main entry is missing');
const { heroSubtitle } = settings.data;
---

<section id="hero">
  <div class="hero-container">
    <h1><br />North Hampshire <span style="font-family: 'Allerta Stencil', sans-serif;"> Repair Café</span></h1>
    <h2>{heroSubtitle}</h2>
    <div class="d-flex">
      <a href="#next-event" class="btn-get-started scrollto">Book a repair</a>
      <a href="#features" class="btn-watch-video scrollto">
        <span>Find your nearest location</span>
      </a>
    </div>
  </div>
</section>
